{
  "name": "opentab-global",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "test": "npm test -w packages/shared",
    "test:contracts": "cargo test --locked",
    "smoke:pay": "node scripts/smoke-pay.mjs",
    "test:e2e": "playwright test",
    "test:api": "node --experimental-strip-types scripts/e2e-api.mts",
    "test:security": "node --experimental-strip-types scripts/security-api.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
